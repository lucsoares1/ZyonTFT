{
  "name": "zyon-tft",
  "version": "0.17.1",
  "private": true,
  "description": "Overlay pessoal de comps e destaques de loja para TFT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5199 --strictPort",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/verify.mjs",
    "package": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:portable": "npm run build && electron-builder --win portable --x64 --publish never",
    "release": "node scripts/release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "data:sync": "node scripts/sync-data.mjs",
    "data:workspace": "node scripts/sync-workspace.mjs",
    "data:portraits": "node scripts/sync-portraits.mjs",
    "data:levels": "node scripts/sync-level-rules.mjs",
    "data:comps": "node scripts/sync-comps.mjs",
    "data:pivot": "node scripts/sync-pivot.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lucsoares1/ZyonTFT.git"
  },
  "build": {
    "asarUnpack": [
      "electron/*.ps1",
      "electron/game-processes.json",
      "electron/ocr/**/*",
      "node_modules/**/*"
    ],
    "appId": "local.zyon.tft",
    "productName": "Zyon TFT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/shop.mjs",
      "src/duo-plans.mjs",
      "src/generated/catalog.json",
      "src/generated/pivot.json",
      "src/generated/pivot-registry.json",
      "src/pivot-catalog.mjs",
      "src/comp-catalog.mjs",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "artifactName": "Zyon-TFT-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "Zyon TFT"
    },
    "portable": {
      "artifactName": "Zyon-TFT-Portable-${version}.${ext}",
      "unpackDirName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lucsoares1",
        "repo": "ZyonTFT",
        "private": false,
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "electron-updater": "6.8.11",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@fontsource/manrope": "^5.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.0.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.51.0",
    "prettier": "^3.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
